{
  "name": "@framer/plugin",
  "description": "Extend Framer with Plugins.",
  "version": "4.1.0",
  "type": "module",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./package.json": "./package.json",
    "./framer.css": "./styles/framer.css",
    "./inter.css": "./styles/inter.css"
  },
  "files": [
    "dist/",
    "styles/"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --minify --tsconfig tsconfig.build.json && yarn build:dts",
    "build:dts": "yarn :tsc --project tsconfig.dts.json",
    "dev": "tsup src/index.ts --format esm --sourcemap --watch",
    "lint": "yarn :lint . --report-unused-disable-directives --max-warnings 0",
    "test": "yarn :jest",
    "clean": "rm -rf dist",
    "typecheck": "yarn :tsc --noEmit --project tsconfig.build.json",
    "watch-typechecking": "yarn :tsc --noEmit --watch --project tsconfig.build.json",
    "test-type-defintions": "tsd",
    "prepack": "exit 0; covered by Makefile, do not change",
    "prepublish": "exit 0; covered by Makefile, do not change",
    "prepublishOnly": "echo 'Please use make for publishing' && exit 1"
  },
  "peerDependencies": {
    "csstype": "^3.1.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.58.2",
    "@types/react": "18.2",
    "@types/react-dom": "18.2",
    "csstype": "^3.1.1",
    "oxlint": "^1.74.0",
    "tsd": "^0.33.0",
    "tsup": "8.5.0",
    "typescript": "^6.0.3"
  }
}