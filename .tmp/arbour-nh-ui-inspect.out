    "controls": {
      "$control__mobileLayoutOverride": "Inherit",
      "$control__territories": "[{\"type\":\"object\",\"value\":{\"name\":{\"type\":\"string\",\"value\":\"Chelsea\"},\"imageUrl\":{\"type\":\"string\",\"value\":\"https://framerusercontent.com/images/8IGPbFclzfRApOAIssLZgmHsnw.png\"},\"slug\":{\"type\":\"string\",\"value\":\"chelsea\"},\"alt\":{\"type\":\"string\",\"value\":\"Explore prime Chelsea homes for sale, from Cheyne Walk river frontages to quiet garden squares off the King's Road.\"},\"coords\":{\"type\":\"string\",\"value\":\"51.4875° N — 0.1687° W\"}},\"id\":\"default-item-0\"},{\"type\":\"object\",\"value\":{\"name\":{\"type\":\"string\",\"value\":\"Notting Hill\"},\"imageUrl\":{\"type\":\"string\",\"value\":\"https://framerusercontent.com/images/AOaAcGKE51AkwHdqIubUdXQHRf8.png\"},\"slug\":{\"type\":\"string\",\"value\":\"notting-hill\"},\"alt\":{\"type\":\"string\",\"value\":\"Discover Notting Hill's finest pastel townhouses and garden squares, moments from Portobello Road.\"},\"coords\":{\"type\":\"string\",\"value\":\"51.5090° N — 0.1963° W\"}},\"id\":\"default-item-1\"},{\"type\":\"object\",\"value\":{\"name\":{\"type\":\"string\",\"value\":\"Hampstead\"},\"imageUrl\":{\"type\":\"string\",\"value\":\"https://framerusercontent.com/images/cCQCSnQDjuSX1xXtwUtrzIHQ.png\"},\"slug\":{\"type\":\"string\",\"value\":\"hampstead\"},\"alt\":{\"type\":\"string\",\"value\":\"Search Hampstead's finest period houses, moments from the Heath and Kenwood House.\"},\"coords\":{\"type\":\"string\",\"value\":\"51.5560° N — 0.1780° W\"}},\"id\":\"default-item-2\"},{\"type\":\"object\",\"value\":{\"name\":{\"type\":\"string\",\"value\":\"The Cotswolds\"},\"imageUrl\":{\"type\":\"string\",\"value\":\"https://framerusercontent.com/images/UT2rfsfKG6VCT8OfYxd7DZWEA0.png\"},\"slug\":{\"type\":\"string\",\"value\":\"the-cotswolds\"},\"alt\":{\"type\":\"string\",\"value\":\"Browse country houses and cottages for sale across the Cotswolds' finest villages.\"},\"coords\":{\"type\":\"string\",\"value\":\"51.8330° N — 1.8433° W\"}},\"id\":\"default-item-3\"}]",
      "$control__content": "{\"itemLimit\":{\"type\":\"number\",\"value\":12},\"linkBase\":{\"type\":\"string\",\"value\":\"/neighbourhoods\"},\"viewLabel\":{\"type\":\"string\",\"value\":\"VIEW →\"},\"ariaLabel\":{\"type\":\"string\",\"value\":\"Territories\"}}",
      "$control__layout": "{\"variant\":{\"type\":\"enum\",\"value\":\"slide\"},\"imageRatio\":{\"type\":\"number\",\"value\":1.74},\"stripWidth\":{\"type\":\"number\",\"value\":160},\"stripHeight\":{\"type\":\"number\",\"value\":240},\"stripLift\":{\"type\":\"number\",\"value\":26},\"stripInactiveOpacity\":{\"type\":\"number\",\"value\":0.4},\"stripGap\":{\"type\":\"number\",\"value\":0},\"stripPosition\":{\"type\":\"enum\",\"value\":\"bottom\"},\"imagePadding\":{\"type\":\"number\",\"value\":0},\"textAlign\":{\"type\":\"enum\",\"value\":\"center\"},\"contentPadding\":{\"type\":\"number\",\"value\":40},\"contentPosition\":{\"type\":\"enum\",\"value\":\"top\"},\"topBandAlign\":{\"type\":\"enum\",\"value\":\"inline\"},\"showEditorialIndex\":{\"type\":\"boolean\",\"value\":false},\"showViewLink\":{\"type\":\"boolean\",\"value\":false},\"cardWidth\":{\"type\":\"number\",\"value\":360}}",
      "$control__typography": "{\"titleFont\":{\"type\":\"font\",\"value\":{\"fontSelector\":\"GF;Noto Serif-regular\",\"fontSize\":\"16px\",\"letterSpacing\":[-0.03,\"em\"],\"lineHeight\":[1,\"em\"]}},\"metaFont\":{\"type\":\"font\",\"value\":{\"fontSelector\":\"GF;Fragment Mono-regular\",\"fontSize\":\"11px\",\"letterSpacing\":[0.12,\"em\"],\"lineHeight\":[1,\"em\"]}},\"titleUppercase\":{\"type\":\"boolean\",\"value\":true}}",
